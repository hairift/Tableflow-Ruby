<% content_for :title, "#{@kategori.nama} | Panel Tableflow-Scan" %>
<div class="kartu p-6">
  <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-aksen">Kategori</p>
  <h1 class="judul-display mt-1 text-3xl"><%= @kategori.nama %></h1>
  <div class="mt-5 flex gap-2">
    <%= link_to "Edit", edit_admin_kategori_path(@kategori), class: "tombol tombol-gelap !text-xs" %>
    <%= link_to "Kembali", admin_kategori_index_path, class: "tombol tombol-garis !text-xs" %>
  </div>
</div>
