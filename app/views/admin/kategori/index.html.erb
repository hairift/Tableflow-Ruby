<% content_for :title, "Kategori — Panel Tableflow-Scan" %>

<div class="flex flex-wrap items-end justify-between gap-3">
  <div>
    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-terakota">Menu</p>
    <h1 class="judul-display mt-1 text-3xl">Kategori</h1>
  </div>
  <%= link_to new_admin_kategori_path, class: "tombol tombol-gelap !text-xs" do %>
    <%= ikon "tambah", kelas: "h-4 w-4" %> Tambah kategori
  <% end %>
</div>

<div class="kartu mt-6 overflow-hidden">
  <table class="tabel-data">
    <thead><tr><th>Nama</th><th>Urutan</th><th>Estimasi</th><th>Produk</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% @kategori.each do |kategori| %>
        <tr>
          <td class="font-bold"><%= kategori.nama %></td>
          <td><%= kategori.urutan %></td>
          <td><%= kategori.estimasi_menit ? "#{kategori.estimasi_menit} menit" : "—" %></td>
          <td><%= kategori.produk.count %></td>
          <td><span class="lencana lencana-<%= kategori.aktif? ? 'hijau' : 'netral' %>"><%= kategori.aktif? ? "Aktif" : "Nonaktif" %></span></td>
          <td class="flex gap-3 text-xs font-bold">
            <%= link_to "Edit", edit_admin_kategori_path(kategori), class: "text-tinta/60" %>
            <%= button_to "Hapus", admin_kategori_path(kategori), method: :delete, class: "text-merah" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
