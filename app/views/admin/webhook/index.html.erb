<% content_for :title, "Webhook — Panel Tableflow-Scan" %>

<div>
  <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-terakota">Pengelolaan</p>
  <h1 class="judul-display mt-1 text-3xl">Webhook</h1>
  <p class="mt-2 max-w-2xl text-sm text-tinta/55">Kirim notifikasi kejadian pesanan ke sistem lain. Setiap permintaan ditandatangani dengan HMAC-SHA256.</p>
</div>

<% if @rahasia_baru.present? %>
  <div class="mt-6 rounded-xl border border-emas/40 bg-[#fbf0d9] px-5 py-4">
    <p class="text-sm font-bold">Rahasia penandatanganan webhook</p>
    <code class="mt-2 block break-all rounded-lg bg-white px-3 py-2 text-xs"><%= @rahasia_baru %></code>
    <p class="mt-2 text-[11px] text-tinta/55">Simpan rahasia ini untuk memverifikasi header X-Tableflow-Signature.</p>
  </div>
<% end %>

<div class="kartu mt-6 p-6">
  <%= form_with url: admin_webhook_index_path, method: :post, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :url, "Alamat tujuan", class: "label-form" %>
      <%= form.url_field :url, class: "kolom-form", required: true, placeholder: "https://contoh.com/webhook" %>
    </div>
    <div>
      <p class="label-form">Kejadian yang dikirim</p>
      <div class="flex flex-wrap gap-4">
        <% Webhook::EVENT.each do |event| %>
          <label class="flex items-center gap-2 text-sm font-semibold">
            <%= check_box_tag "event[]", event, true, class: "h-4 w-4 accent-terakota" %> <%= event %>
          </label>
        <% end %>
      </div>
    </div>
    <%= form.button class: "tombol tombol-utama" do %><%= ikon "tautan", kelas: "h-4 w-4" %> Daftarkan webhook<% end %>
  <% end %>
</div>

<div class="kartu mt-6 overflow-hidden">
  <table class="tabel-data">
    <thead><tr><th>Alamat</th><th>Kejadian</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% @webhook.each do |webhook| %>
        <tr>
          <td class="break-all font-bold"><%= webhook.url %></td>
          <td class="text-xs"><%= webhook.daftar_event_array.join(", ") %></td>
          <td><span class="lencana lencana-<%= webhook.aktif? ? 'hijau' : 'netral' %>"><%= webhook.aktif? ? "Aktif" : "Nonaktif" %></span></td>
          <td><%= button_to "Hapus", admin_webhook_path(webhook), method: :delete, class: "text-xs font-bold text-merah" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
