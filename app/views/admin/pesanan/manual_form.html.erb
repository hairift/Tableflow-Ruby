<% content_for :title, "Pesanan manual — Panel Tableflow-Scan" %>

<div class="flex flex-wrap items-end justify-between gap-3">
  <div>
    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-terakota">Kasir</p>
    <h1 class="judul-display mt-1 text-3xl">Pesanan manual</h1>
    <p class="mt-1 text-sm text-tinta/50">Untuk pembelian di counter atau takeaway.</p>
  </div>
  <%= link_to admin_pesanan_index_path, class: "tombol tombol-garis !text-xs" do %>
    <%= ikon "kiri", kelas: "h-4 w-4" %> Kembali
  <% end %>
</div>

<%= form_with url: manual_admin_pesanan_index_path, method: :post, local: true, class: "mt-6 grid gap-6 lg:grid-cols-3" do |form| %>
  <div class="kartu overflow-hidden lg:col-span-2">
    <div class="border-b border-garis px-5 py-4">
      <h2 class="text-sm font-bold">Pilih menu</h2>
    </div>
    <div class="divide-y divide-garis">
      <% @produk.each_with_index do |produk, indeks| %>
        <label class="flex items-center gap-4 px-5 py-3.5 hover:bg-krim">
          <input type="hidden" name="item[<%= indeks %>][produk_id]" value="0">
          <input type="checkbox" name="item[<%= indeks %>][produk_id]" value="<%= produk.id %>" class="h-4 w-4 accent-terakota">
          <span class="flex-1 text-sm font-semibold"><%= produk.nama %></span>
          <span class="bilangan text-xs font-bold text-terakota">Rp <%= number_with_delimiter(produk.harga.to_i) %></span>
          <input type="number" name="item[<%= indeks %>][jumlah]" value="1" min="1" class="w-16 rounded-lg border border-garis px-2 py-1 text-center text-xs">
          <input type="hidden" name="item[<%= indeks %>][opsi_varian_ids][]" value="">
        </label>
      <% end %>
    </div>
  </div>

  <div class="space-y-5">
    <div class="kartu p-5">
      <h2 class="text-sm font-bold">Data pelanggan</h2>
      <div class="mt-4 space-y-3">
        <div>
          <%= form.label :nama_pelanggan, "Nama", class: "label-form" %>
          <%= form.text_field :nama_pelanggan, class: "kolom-form", placeholder: "Opsional" %>
        </div>
        <div>
          <%= form.label :telepon_pelanggan, "Telepon member", class: "label-form" %>
          <%= form.text_field :telepon_pelanggan, class: "kolom-form", placeholder: "08xxxxxxxxxx" %>
        </div>
        <div>
          <%= form.label :catatan, "Catatan", class: "label-form" %>
          <%= form.text_field :catatan, class: "kolom-form" %>
        </div>
      </div>
    </div>

    <div class="kartu p-5">
      <h2 class="text-sm font-bold">Pembayaran</h2>
      <div class="mt-4 space-y-3">
        <div>
          <%= form.label :metode, "Metode", class: "label-form" %>
          <%= form.select :metode, [["QRIS", "qris"], ["Tunai", "tunai"], ["Debit", "debit"]], {}, class: "kolom-form" %>
        </div>
        <div>
          <%= form.label :jumlah_diskon, "Diskon (Rp)", class: "label-form" %>
          <%= form.number_field :jumlah_diskon, value: 0, min: 0, class: "kolom-form" %>
        </div>
        <div>
          <%= form.label :alasan_diskon, "Alasan diskon", class: "label-form" %>
          <%= form.text_field :alasan_diskon, class: "kolom-form", placeholder: "Opsional" %>
        </div>
      </div>
    </div>

    <%= form.button class: "tombol tombol-utama w-full !py-3" do %>
      <%= ikon "tambah", kelas: "h-5 w-5" %> Buat pesanan
    <% end %>
  </div>
<% end %>
