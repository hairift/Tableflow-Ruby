<% content_for :title, "Meja #{@meja.nomor_meja} | Panel Tableflow-Scan" %>

<div class="flex flex-wrap items-end justify-between gap-3">
  <div>
    <%= link_to admin_meja_index_path, class: "text-xs font-semibold text-tinta/45" do %><%= ikon "kiri", kelas: "mr-1 inline h-3.5 w-3.5" %> Kembali<% end %>
    <h1 class="judul-display mt-2 text-3xl">Meja <%= @meja.nomor_meja %></h1>
    <p class="mt-1 text-xs text-tinta/50">Kapasitas <%= @meja.kapasitas %> kursi</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to qr_admin_meja_path(@meja), target: "_blank", class: "tombol tombol-garis !text-xs" do %>
      <%= ikon "kode-qr", kelas: "h-4 w-4" %> Lihat QR
    <% end %>
    <%= button_to reset_token_admin_meja_path(@meja), method: :post, class: "tombol tombol-garis !text-xs" do %>
      <%= ikon "segarkan", kelas: "h-4 w-4" %> Reset token
    <% end %>
    <%= link_to edit_admin_meja_path(@meja), class: "tombol tombol-gelap !text-xs" do %>
      <%= ikon "sunting", kelas: "h-4 w-4" %> Edit
    <% end %>
  </div>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <div class="kartu p-6">
    <h2 class="text-sm font-bold">Tautan pemesanan</h2>
    <p class="mt-2 break-all rounded-lg bg-krim px-3 py-2 text-xs text-tinta/60"><%= request.base_url %>/t/<%= @meja.token_qr %></p>
    <p class="mt-3 text-xs leading-relaxed text-tinta/50">Token QR dibuat dengan HMAC-SHA256 menggunakan rahasia khusus meja. Mereset token membuat tautan lama tidak berlaku.</p>
  </div>

  <div class="kartu p-6">
    <h2 class="text-sm font-bold">Kunjungan berjalan</h2>
    <p class="mt-2 text-sm text-tinta/60">
      <%= @meja.mulai_kunjungan_pada ? @meja.mulai_kunjungan_pada.in_time_zone("Asia/Jakarta").strftime("%d/%m/%Y %H:%M") : "Belum ada kunjungan" %>
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      <%= button_to tagihan_admin_meja_path(@meja), method: :patch, class: "tombol tombol-garis !text-xs" do %>
        <%= ikon "struk", kelas: "h-4 w-4" %> <%= @meja.tagihan_terbuka? ? "Tutup tagihan" : "Buka tagihan" %>
      <% end %>
      <%= button_to selesai_kunjungan_admin_meja_path(@meja), method: :patch, class: "tombol tombol-garis !text-xs" do %>
        <%= ikon "centang", kelas: "h-4 w-4" %> Selesaikan kunjungan
      <% end %>
    </div>
  </div>
</div>

<div class="kartu mt-6 overflow-hidden">
  <div class="border-b border-garis px-5 py-4"><h2 class="text-sm font-bold">Pesanan terakhir</h2></div>
  <% @meja.pesanan.order(created_at: :desc).limit(10).each do |pesanan| %>
    <div class="flex items-center justify-between border-b border-garis px-5 py-3 last:border-0">
      <span class="text-sm font-bold"><%= pesanan.kode_pesanan %></span>
      <span class="text-xs text-tinta/50"><%= pesanan.status.tr("_", " ") %></span>
      <span class="bilangan text-sm font-semibold">Rp <%= number_with_delimiter(pesanan.total_harga.to_i) %></span>
    </div>
  <% end %>
</div>
